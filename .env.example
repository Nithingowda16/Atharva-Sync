# ============================================================================
# ATHARVA TRAVELS ETS - ENVIRONMENT CONFIGURATION
# ============================================================================

# 1. Google Maps JavaScript API Key (Enables genuine Google Maps live tracking)
# Get your key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# 2. PostgreSQL Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/atharva_ets?schema=public"

# 3. NextAuth / JWT Secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# 4. Push Notification Gateway (Expo / FCM)
EXPO_ACCESS_TOKEN=""

